{
  "name": "Buscador de Ofertas AI Agent Pro (Loop & Quality)",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "folder",
        "path": "/n8n-watch/busqueda_ofertas_equipos/peticiones_oferta",
        "events": ["add"],
        "options": { "awaitWriteFinish": true, "usePolling": true }
      },
      "name": "Local File Trigger",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [-1000, 300],
      "id": "2b03acad-fb52-4637-b4d2-14b34fa154a5"
    },
    {
      "parameters": { "command": "=cat \"{{$json.path}}\"" },
      "name": "Read Text File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-800, 300],
      "id": "ad513cf6-6f59-4787-9875-6ad3d96bebcb"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.5.152:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "qwen2.5:14b" },
            {
              "name": "prompt",
              "value": "=Analiza esta peticion: '{{$json.stdout}}'. Extrae un JSON con: 'keywords' (3-4 palabras clave), 'presupuesto' (int), 'tipo' (Portatil/Sobremesa), 'pMin' (30% del presupuesto). Responde SOLO el JSON."
            },
            { "name": "stream", "value": false },
            { "name": "format", "value": "json" }
          ]
        }
      },
      "name": "Ollama Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [-600, 300],
      "id": "a8b6cf5d-2299-4a0c-a064-5b705be46c08"
    },
    {
      "parameters": {
        "jsCode": "let res;\ntry {\n  res = JSON.parse($input.item.json.response);\n} catch (e) {\n  res = { keywords: 'PC Desktop', presupuesto: 1000, tipo: 'Sobremesa', pMin: 300 };\n}\nreturn { json: { q: res.keywords, pMax: res.presupuesto, pMin: res.pMin || 150, tipo: res.tipo, retryCount: 0 } };"
      },
      "name": "Preparar Busqueda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [-400, 300],
      "id": "6b265c1e-1d07-4d8e-a68b-a54f94d6f0f9"
    },
    {
      "parameters": {
        "url": "=https://serpapi.com/search.json?q={{$json.q}}+site:pccomponentes.com&api_key=52fcdd105cf07cc0a4d0f69bde6ce978fdcbd4deb98db0667866f6a21be74594",
        "options": {}
      },
      "continueOnFail": true,
      "name": "PcComponentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [0, 0],
      "id": "d90de13f-bfb0-4cd9-abf1-c03837d448f8"
    },
    {
      "parameters": {
        "url": "=https://api.rainforestapi.com/request?api_key=8531EA9640A248D0B0C517E23131F9A5&type=search&amazon_domain=amazon.es&search_term={{$json.q}}",
        "options": {}
      },
      "continueOnFail": true,
      "name": "Amazon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [0, 200],
      "id": "72f5d2cf-c907-4242-8b35-d021b8e80a0b"
    },
    {
      "parameters": {
        "url": "=https://serpapi.com/search.json?q={{$json.q}}+site:coolmod.com&api_key=52fcdd105cf07cc0a4d0f69bde6ce978fdcbd4deb98db0667866f6a21be74594",
        "options": {}
      },
      "continueOnFail": true,
      "name": "Coolmod",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [0, 400],
      "id": "87b1b1c6-9279-406d-a6eb-c3dc6f2693eb"
    },
    {
      "parameters": {
        "url": "=https://serpapi.com/search.json?q={{$json.q}}+site:mediamarkt.es&api_key=52fcdd105cf07cc0a4d0f69bde6ce978fdcbd4deb98db0667866f6a21be74594",
        "options": {}
      },
      "continueOnFail": true,
      "name": "MediaMarkt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [0, 600],
      "id": "b8cf937a-a018-437a-bbb2-c81f7cc149f9"
    },
    {
      "parameters": { "mode": "combine", "combinationMode": "mergeByPosition" },
      "name": "Merge Final",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [300, 300],
      "id": "50951c10-39bb-4fcf-8299-be72629b869c"
    },
    {
      "parameters": {
        "jsCode": "let all = [];\nconst pCfg = $('Preparar Busqueda').first().json;\nconst pMin = pCfg.pMin;\nconst pMax = pCfg.pMax;\n\n$input.all().forEach(item => {\n  const d = item.json;\n  if (d.organic_results) {\n    d.organic_results.forEach(r => {\n      const pMatch = (r.rich_snippet?.top?.detected_extensions?.price) || \n                     (r.snippet?.match(/(\\d{1,3}(?:\\.\\d{3})*(?:,\\d{2})?)\\s?€/)?.[1]);\n      let price = pMatch ? parseFloat(String(pMatch).replace('.', '').replace(',', '.')) : 0;\n      if (price >= pMin && price <= pMax) {\n        all.push({ title: r.title, price, link: r.link, source: r.link.includes('pccomponentes') ? 'PcComponentes' : (r.link.includes('coolmod') ? 'Coolmod' : 'MediaMarkt'), snippet: r.snippet || '' });\n      }\n    });\n  }\n  if (d.search_results) {\n    d.search_results.forEach(r => {\n      const price = r.price?.value || 0;\n      if (price >= pMin && price <= pMax) {\n        all.push({ title: r.title, price, link: r.link, source: 'Amazon', snippet: '' });\n      }\n    });\n  }\n});\nreturn all.sort((a,b) => a.price - b.price).slice(0,12).map(p => ({ json: p }));"
      },
      "name": "Filtrar y Preparar Agente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [500, 300],
      "id": "39f58b29-5c56-48e0-8c6f-53a1b0c0d761"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "=Eres un Ingeniero de Compras de Hardware. Analiza los productos y extrae: MARCA, MODELO, CPU, RAM, GPU, DISCO, SO. DESCARTA accesorios. Si falta un dato, deducelo. Responde JSON."
        }
      },
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [700, 300],
      "id": "17208d1a-a852-465f-b38c-b7d1b4cf6a77"
    },
    {
      "parameters": {
        "model": "qwen2.5:14b",
        "options": { "temperature": 0.1 }
      },
      "credentials": {
        "ollamaApi": { "id": "pg9O0Dpxjc3upDzI" }
      },
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [600, 550],
      "id": "ca68c699-28d6-4189-9434-41227079b34e"
    },
    {
      "parameters": {
        "contextWindowLength": 5,
        "sessionId": "={{ $node[\"Read Text File\"].json.path }}"
      },
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [800, 550],
      "id": "3d1f2141-473f-4eb0-8319-575d0d366746"
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{$input.all().length}}", "operation": "larger", "value2": 2 }]
        }
      },
      "name": "Validar Calidad",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [950, 300],
      "id": "7ba405b5-082e-4cbd-bbe9-f4aa0a3cac61"
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all().map(i => {\n  let p = i.json.output ? JSON.parse(i.json.output.replace(/```json|```/g, '')) : i.json;\n  return Array.isArray(p) ? p[0] : p;\n});\nconst pCfg = $('Preparar Busqueda').first().json;\nlet html = `<html><head><style>body{font-family:'Inter',sans-serif;padding:40px;background:#f1f5f9;color:#1e293b}.header{background:#0f172a;color:#fff;padding:25px;border-radius:12px 12px 0 0}table{width:100%;border-collapse:collapse;background:#fff}th{background:#f8fafc;padding:12px;text-align:left;border-bottom:2px solid #e2e8f0}td{padding:12px;border-bottom:1px solid #f1f5f9}.price{color:#059669;font-weight:700}.btn{padding:6px 12px;background:#2563eb;color:#fff;text-decoration:none;border-radius:6px}</style></head><body><div class=\"header\"><h1>Propuesta Hardware</h1><div>Presupuesto: ${pCfg.pMax}€</div></div><table><thead><tr><th>Marca/Modelo</th><th>Specs</th><th>Precio</th><th>Link</th></tr></thead><tbody>`;\nproducts.forEach(p => {\n  html += `<tr><td><b>${p.MARCA}</b><br>${p.MODELO}</td><td>${p.CPU} | ${p.RAM} | ${p.GPU} | ${p.DISCO}</td><td class=\"price\">${p.price}€</td><td><a class=\"btn\" href=\"${p.link}\">Ver</a></td></tr>`;\n});\nhtml += `</tbody></table></body></html>`;\nreturn [{ binary: { index: { data: Buffer.from(html).toString('base64'), mimeType: 'text/html', fileName: 'index.html' } } }];"
      },
      "name": "Generar HTML PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1200, 200],
      "id": "8558181a-e90a-4ee8-bfb5-d638b3980558"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://gotenberg:3000/forms/chromium/convert/html",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [{ "name": "files", "parameterType": "formBinaryData", "inputDataFieldName": "index" }]
        }
      },
      "name": "Gotenberg PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1400, 200],
      "id": "60746efd-f2ec-46ee-95aa-8f31e26445f3"
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/n8n-watch/busqueda_ofertas_equipos/propuestas_generadas/informe_{{$now.toFormat('yyyyMMdd_HHmmss')}}.pdf"
      },
      "name": "Guardar PDF",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1600, 200],
      "id": "3bbce164-33c9-421d-9d55-df7fa02c88b5"
    },
    {
      "parameters": {
        "jsCode": "return { json: { q: $('Preparar Busqueda').first().json.q + ' oferta', retry: true } };"
      },
      "name": "Reformular Busqueda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1200, 450],
      "id": "e29462bf-6133-492b-bbd5-6295357b847a"
    }
  ],
  "connections": {
    "Local File Trigger": { "main": [[{ "node": "Read Text File", "type": "main", "index": 0 }]] },
    "Read Text File": { "main": [[{ "node": "Ollama Extract", "type": "main", "index": 0 }]] },
    "Ollama Extract": { "main": [[{ "node": "Preparar Busqueda", "type": "main", "index": 0 }]] },
    "Preparar Busqueda": { "main": [[{ "node": "PcComponentes", "type": "main", "index": 0 }, { "node": "Amazon", "type": "main", "index": 0 }, { "node": "Coolmod", "type": "main", "index": 0 }, { "node": "MediaMarkt", "type": "main", "index": 0 }]] },
    "PcComponentes": { "main": [[{ "node": "Merge Final", "type": "main", "index": 0 }]] },
    "Amazon": { "main": [[{ "node": "Merge Final", "type": "main", "index": 1 }]] },
    "Coolmod": { "main": [[{ "node": "Merge Final", "type": "main", "index": 2 }]] },
    "MediaMarkt": { "main": [[{ "node": "Merge Final", "type": "main", "index": 3 }]] },
    "Merge Final": { "main": [[{ "node": "Filtrar y Preparar Agente", "type": "main", "index": 0 }]] },
    "Filtrar y Preparar Agente": { "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]] },
    "Ollama Chat Model": { "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]] },
    "Simple Memory": { "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]] },
    "AI Agent": { "main": [[{ "node": "Validar Calidad", "type": "main", "index": 0 }]] },
    "Validar Calidad": { "main": [[{ "node": "Generar HTML PDF", "type": "main", "index": 0 }], [{ "node": "Reformular Busqueda", "type": "main", "index": 0 }]] },
    "Reformular Busqueda": { "main": [[{ "node": "PcComponentes", "type": "main", "index": 0 }, { "node": "Amazon", "type": "main", "index": 0 }, { "node": "Coolmod", "type": "main", "index": 0 }, { "node": "MediaMarkt", "type": "main", "index": 0 }]] },
    "Generar HTML PDF": { "main": [[{ "node": "Gotenberg PDF", "type": "main", "index": 0 }]] },
    "Gotenberg PDF": { "main": [[{ "node": "Guardar PDF", "type": "main", "index": 0 }]] }
  }
}